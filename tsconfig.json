{
  "compilerOptions": {
    "target": "es2019",
    "strict": true,
    "module": "node16",
    "moduleResolution": "node16",
    "types": ["node"],
    "removeComments": false,
    "resolveJsonModule": true,
    "sourceMap": true,
    "rootDir": "src",
    "outDir": "out",
    "lib": [
      "es2020"
    ]
  },
  "exclude": [
    "**/*.test.ts",
    "docs",
  ]
}