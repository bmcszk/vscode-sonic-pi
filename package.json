{
	"name": "sonic-pi-5-extension",
	"displayName": "Sonic Pi 5 Extension",
	"publisher": "blazesoftware",
	"description": "Language support and code running for Sonic Pi scripts",
	"preview": true,
	"version": "0.2.2",
	"license": "MIT",
	"homepage": "https://github.com/bmcszk/vscode-sonic-pi#readme",
	"keywords": [
		"sonic pi",
		"live coding",
		"music",
		"audio",
		"ruby"
	],
	"repository": {
		"url": "https://github.com/bmcszk/vscode-sonic-pi"
	},
	"scripts": {
		"build": "tsc",
		"lint": "eslint src",
		"format:check": "prettier --check src",
		"format": "prettier --write src",
		"prepare": "git rev-parse --is-inside-work-tree >/dev/null 2>&1 && git config core.hooksPath .githooks || true",
		"test": "npm run lint && npm run format:check && npm run test:unit && node test/vsix-smoke.test.js",
		"test:unit": "npm run build && node test/run-unit.js",
		"test:integration": "npm run build && vscode-test",
		"test:e2e": "npm run build && node test/e2e/protocol.js"
	},
	"icon": "img/icon.png",
	"engines": {
		"vscode": "^1.144.0"
	},
	"categories": [
		"Programming Languages"
	],
	"activationEvents": [
		"onLanguage:sonic-pi",
		"onCommand:vscode-sonic-pi.openExamples",
		"onCommand:vscode-sonic-pi.openTutorial",
		"onCommand:vscode-sonic-pi.startserver",
		"onCommand:vscode-sonic-pi.run",
		"onCommand:vscode-sonic-pi.beautify",
		"onCommand:vscode-sonic-pi.togglerecording",
		"onCommand:vscode-sonic-pi.docs",
		"onCommand:vscode-sonic-pi.stopNotebook",
		"onCommand:vscode-sonic-pi.stop",
		"onCommand:vscode-sonic-pi.restartserver",
		"onCommand:vscode-sonic-pi.checkInstall",
		"onCommand:vscode-sonic-pi.runCell",
		"onCommand:vscode-sonic-pi.runselected",
		"onCommand:vscode-sonic-pi.newNotebook",
		"onCommand:vscode-sonic-pi.cues._clear",
		"onCommand:vscode-sonic-pi.cues._pause",
		"onCommand:vscode-sonic-pi.cues._filter",
		"onCommand:vscode-sonic-pi.cues._portStop",
		"onCommand:vscode-sonic-pi.cues._portStart",
		"onCommand:vscode-sonic-pi.cues._portExternal",
		"onCommand:vscode-sonic-pi.cues._portInternal",
		"onCommand:vscode-sonic-pi.cueInsertSync",
		"onCommand:vscode-sonic-pi.cueSendTest",
		"onCommand:vscode-sonic-pi.mixer",
		"onCommand:vscode-sonic-pi.audioDevices",
		"onCommand:vscode-sonic-pi.reopenAudioDevice",
		"onCommand:vscode-sonic-pi.muteLoop",
		"onCommand:vscode-sonic-pi.unmuteLoop",
		"onNotebook:sonic-pi-book",
		"onCommand:vscode-sonic-pi.midiDevices",
		"onCommand:vscode-sonic-pi.gamepads",
		"onCommand:vscode-sonic-pi.setGlobalTimewarp",
		"onCommand:vscode-sonic-pi.openInitFile"
	],
	"main": "./out/extension.js",
	"contributes": {
		"menus": {
			"editor/title": [
				{
					"command": "vscode-sonic-pi.run",
					"group": "navigation",
					"when": "editorLangId=='sonic-pi' && notebookType!='sonic-pi-book'"
				}
			],
			"view/title": [
				{
					"command": "vscode-sonic-pi.cues._filter",
					"when": "view == sonic-pi.cues",
					"group": "navigation@1"
				},
				{
					"command": "vscode-sonic-pi.cues._pause",
					"when": "view == sonic-pi.cues",
					"group": "navigation@2"
				},
				{
					"command": "vscode-sonic-pi.cueSendTest",
					"when": "view == sonic-pi.cues",
					"group": "navigation@3"
				},
				{
					"command": "vscode-sonic-pi.cues._clear",
					"when": "view == sonic-pi.cues",
					"group": "navigation@4"
				},
				{
					"command": "vscode-sonic-pi.cues._portStop",
					"when": "view == sonic-pi.cues",
					"group": "cuePort@1"
				},
				{
					"command": "vscode-sonic-pi.cues._portStart",
					"when": "view == sonic-pi.cues",
					"group": "cuePort@2"
				},
				{
					"command": "vscode-sonic-pi.cues._portExternal",
					"when": "view == sonic-pi.cues",
					"group": "cuePort@3"
				},
				{
					"command": "vscode-sonic-pi.cues._portInternal",
					"when": "view == sonic-pi.cues",
					"group": "cuePort@4"
				}
			],
			"file/newFile": [
				{
					"command": "vscode-sonic-pi.newNotebook",
					"group": "notebook"
				}
			]
		},
		"walkthroughs": [
			{
				"id": "vscode-sonic-pi.walkthrough",
				"title": "Begin using Sonic Pi in VS Code",
				"description": "Learn how to set up Sonic Pi in VS Code and see some examples for getting started with Sonic Pi development",
				"steps": [
					{
						"id": "vscode-sonic-pi.checkInstall",
						"title": "Verify your Sonic Pi installation",
						"description": "VS Code for Sonic Pi requires Sonic Pi to be installed on your system.\n[Check your Installation](command:vscode-sonic-pi.checkInstall)\nIf you haven't yet downloaded Sonic Pi, go here to [download it now](https://sonic-pi.net/)",
						"completionEvents": [
							"onContext:sonicPiInstalled"
						],
						"media": {
							"image": "img/sonic-pi.png",
							"altText": "Sonic Pi icon"
						}
					},
					{
						"id": "vscode-sonic-pi.openTutorial",
						"title": "Open Sonic Pi Tutorial",
						"description": "Get started with the tutorial for using Sonic Pi in VS Code\n[Open Tutorial](command:vscode-sonic-pi.openTutorial)",
						"media": {
							"image": "img/sonic-pi.png",
							"altText": "Sonic Pi icon"
						}
					},
					{
						"id": "vscode-sonic-pi.openExamples",
						"title": "Open Sonic Pi Examples",
						"description": "Try out some examples of Sonic Pi scripts\n[Open Examples](command:vscode-sonic-pi.openExamples)",
						"media": {
							"image": "img/sonic-pi.png",
							"altText": "Sonic Pi icon"
						}
					}
				]
			}
		],
		"notebooks": [
			{
				"type": "sonic-pi-book",
				"displayName": "Sonic Pi",
				"selector": [
					{
						"filenamePattern": "*.pibook"
					}
				]
			}
		],
		"languages": [
			{
				"id": "sonic-pi",
				"aliases": [
					"Sonic Pi",
					"sonic-pi"
				],
				"extensions": [
					"pi"
				],
				"configuration": "./language-configuration.json"
			}
		],
		"snippets": [
			{
				"language": "sonic-pi",
				"path": "./snippets/sonic-pi.json"
			}
		],
		"commands": [
			{
				"command": "vscode-sonic-pi.startserver",
				"title": "Start Server",
				"category": "Sonic Pi"
			},
			{
				"command": "vscode-sonic-pi.restartserver",
				"title": "Restart Server",
				"category": "Sonic Pi"
			},
			{
				"command": "vscode-sonic-pi.checkInstall",
				"title": "Check Install",
				"category": "Sonic Pi"
			},
			{
				"command": "vscode-sonic-pi.newNotebook",
				"title": "Create new Sonic Pi notebook",
				"shortTitle": "Sonic Pi Book",
				"category": "Sonic Pi"
			},
			{
				"command": "vscode-sonic-pi.openExamples",
				"title": "Open Examples",
				"category": "Sonic Pi"
			},
			{
				"command": "vscode-sonic-pi.openTutorial",
				"title": "Open Tutorial",
				"category": "Sonic Pi"
			},
			{
				"command": "vscode-sonic-pi.run",
				"title": "Run",
				"category": "Sonic Pi",
				"icon": "$(play)"
			},
			{
				"command": "vscode-sonic-pi.runCell",
				"title": "Run Notebook Cell",
				"category": "Sonic Pi"
			},
			{
				"command": "vscode-sonic-pi.runselected",
				"title": "Run selected text",
				"category": "Sonic Pi"
			},
			{
				"command": "vscode-sonic-pi.stop",
				"title": "Stop",
				"category": "Sonic Pi"
			},
			{
				"command": "vscode-sonic-pi.muteLoop",
				"title": "Mute Loop",
				"category": "Sonic Pi"
			},
			{
				"command": "vscode-sonic-pi.unmuteLoop",
				"title": "Unmute Loop",
				"category": "Sonic Pi"
			},
			{
				"command": "vscode-sonic-pi.stopNotebook",
				"title": "Stop Notebook",
				"category": "Sonic Pi"
			},
			{
				"command": "vscode-sonic-pi.docs",
				"title": "Docs",
				"category": "Sonic Pi"
			},
			{
				"command": "vscode-sonic-pi.togglerecording",
				"title": "Toggle recording",
				"category": "Sonic Pi"
			},
			{
				"command": "vscode-sonic-pi.beautify",
				"title": "Beautify",
				"category": "Sonic Pi"
			},
			{
				"command": "vscode-sonic-pi.cues._filter",
				"title": "Filter",
				"icon": "$(filter)"
			},
			{
				"command": "vscode-sonic-pi.cues._pause",
				"title": "Pause",
				"icon": "$(debug-pause)"
			},
			{
				"command": "vscode-sonic-pi.cues._clear",
				"title": "Clear",
				"icon": "$(clear-all)"
			},
			{
				"command": "vscode-sonic-pi.cues._portStop",
				"title": "Cue Port: Stop",
				"category": "Sonic Pi"
			},
			{
				"command": "vscode-sonic-pi.cues._portStart",
				"title": "Cue Port: Start",
				"category": "Sonic Pi"
			},
			{
				"command": "vscode-sonic-pi.cues._portExternal",
				"title": "Cue Port: External",
				"category": "Sonic Pi"
			},
			{
				"command": "vscode-sonic-pi.cues._portInternal",
				"title": "Cue Port: Internal",
				"category": "Sonic Pi"
			},
			{
				"command": "vscode-sonic-pi.cueInsertSync",
				"title": "Cue: Insert Sync",
				"category": "Sonic Pi"
			},
			{
				"command": "vscode-sonic-pi.cueSendTest",
				"title": "Send Test Cue",
				"icon": "$(send)"
			},
			{
				"command": "vscode-sonic-pi.mixer",
				"title": "Mixer",
				"category": "Sonic Pi"
			},
			{
				"command": "vscode-sonic-pi.audioDevices",
				"title": "Audio Devices",
				"category": "Sonic Pi"
			},
			{
				"command": "vscode-sonic-pi.reopenAudioDevice",
				"title": "Reset Audio Device",
				"category": "Sonic Pi"
			},
			{
				"command": "vscode-sonic-pi.midiDevices",
				"title": "MIDI Devices",
				"category": "Sonic Pi"
			},
			{
				"command": "vscode-sonic-pi.gamepads",
				"title": "Gamepads",
				"category": "Sonic Pi"
			},
			{
				"command": "vscode-sonic-pi.setGlobalTimewarp",
				"title": "Set Global Timewarp",
				"category": "Sonic Pi"
			},
			{
				"command": "vscode-sonic-pi.openInitFile",
				"title": "Open init.rb",
				"category": "Sonic Pi"
			}
		],
		"keybindings": [
			{
				"command": "vscode-sonic-pi.run",
				"key": "F5",
				"when": "editorLangId=='sonic-pi' && notebookType!='sonic-pi-book'"
			},
			{
				"command": "vscode-sonic-pi.run",
				"key": "alt+r",
				"when": "editorLangId=='sonic-pi' && notebookType!='sonic-pi-book'"
			},
			{
				"command": "vscode-sonic-pi.runCell",
				"key": "F5",
				"when": "editorLangId=='sonic-pi' && notebookType=='sonic-pi-book'"
			},
			{
				"command": "vscode-sonic-pi.runCell",
				"key": "alt+r",
				"when": "editorLangId=='sonic-pi' && notebookType=='sonic-pi-book'"
			},
			{
				"command": "vscode-sonic-pi.stopNotebook",
				"key": "alt+s",
				"when": "notebookType=='sonic-pi-book'"
			},
			{
				"command": "vscode-sonic-pi.runselected",
				"key": "alt+t",
				"when": "editorLangId=='sonic-pi' && notebookType!='sonic-pi-book'"
			},
			{
				"command": "vscode-sonic-pi.stop",
				"key": "alt+s",
				"when": "editorLangId=='sonic-pi' && notebookType!='sonic-pi-book'"
			},
			{
				"command": "vscode-sonic-pi.togglerecording",
				"key": "shift+alt+r",
				"when": "editorLangId=='sonic-pi'"
			},
			{
				"command": "vscode-sonic-pi.beautify",
				"key": "shift+alt+b",
				"when": "editorLangId=='sonic-pi'"
			}
		],
		"configuration": {
			"title": "Sonic Pi",
			"properties": {
				"vscode-sonic-pi.sonicPiRootDirectory": {
					"type": "string",
					"description": "Set Sonic Pi installation directory.\nOnly use this if the default does not work for you."
				},
				"vscode-sonic-pi.connectionMode": {
					"type": "string",
					"enum": [
						"auto",
						"managed",
						"attach"
					],
					"enumDescriptions": [
						"Attach to a running Sonic Pi app if one is found, otherwise boot our own server",
						"Always boot our own server daemon (previous behavior)",
						"Only attach to a running Sonic Pi app; never boot a server"
					],
					"default": "auto",
					"description": "How to get a Sonic Pi server: attach to the app you run yourself, or manage a daemon."
				},
				"vscode-sonic-pi.rubyLsp.enabled": {
					"type": "boolean",
					"default": true,
					"description": "Enable the ruby-lsp language server for Sonic Pi buffers (diagnostics squiggles, hover, go to definition). Takes effect on window reload."
				},
				"vscode-sonic-pi.rubyLspPath": {
					"type": "string",
					"default": "",
					"description": "Full path to the ruby-lsp executable. Leave empty to look it up on PATH. Requires the bundler gem. Takes effect on window reload."
				},
				"vscode-sonic-pi.launchSonicPiServerAutomatically": {
					"type": "string",
					"enum": [
						"ruby",
						"start",
						"never",
						"custom"
					],
					"enumDescriptions": [
						"Start the server when there is a ruby file open in the editor",
						"Start the server when starting vscode",
						"Do not start the server automatically (must launch it manually through the Sonic Pi: Start Server command)",
						"Start the server when opening a custom file extension - enter in the Launch Sonic Pi Server Custom Extension setting"
					],
					"default": "ruby",
					"description": "Launch Sonic Pi Server automatically when..."
				},
				"vscode-sonic-pi.launchSonicPiServerCustomExtension": {
					"type": "string",
					"description": "If the Launch server automatically setting is set to custom, what extension triggers the launch?"
				},
				"vscode-sonic-pi.runFileWhenRunSelectedIsEmpty": {
					"type": "string",
					"enum": [
						"always",
						"never"
					],
					"description": "If there is no selection when Run selected is triggered, run the whole file"
				},
				"vscode-sonic-pi.invertStereo": {
					"type": "boolean",
					"default": false,
					"description": "Invert stereo"
				},
				"vscode-sonic-pi.forceMono": {
					"type": "boolean",
					"default": false,
					"description": "Force mono output"
				},
				"vscode-sonic-pi.safeMode": {
					"type": "boolean",
					"default": true,
					"description": "Synth argument checking functions.\nIf disabled, certain synth opt values may\ncreate unexpectedly loud or uncomfortable sounds."
				},
				"vscode-sonic-pi.runReplacesSession": {
					"type": "boolean",
					"default": true,
					"description": "A play stops the previous jobs first (per-cell replace, matching the Sonic Pi app's Run button). Turn off to layer runs on top of each other."
				},
				"vscode-sonic-pi.notebookRunsWholeSong": {
					"type": "boolean",
					"default": false,
					"description": "Replay every executed cell of the notebook on each play (the notebook as one instrument). Default off: the played cell runs alone."
				},
				"vscode-sonic-pi.runOnSave": {
					"type": "boolean",
					"default": false,
					"description": "Run the whole file every time you save a Sonic Pi document (the Run lens semantics: the file runs as one script, not the piece you edited). Off by default: a save never plays by itself. Notebook cell saves are not affected."
				},
				"vscode-sonic-pi.stopServerOnLastEditorClose": {
					"type": "boolean",
					"default": false,
					"description": "Stop the Sonic Pi server when the last Sonic Pi editor is closed. Off by default: a running server survives your editing session."
				},
				"vscode-sonic-pi.oscCuesPort": {
					"type": "number",
					"default": 0,
					"description": "Override the OSC cues port. 0 discovers the port from the daemon stdout."
				},
				"vscode-sonic-pi.logAutoscroll": {
					"type": "boolean",
					"default": true,
					"description": "Autoscroll the log"
				},
				"vscode-sonic-pi.logClearOnRun": {
					"type": "boolean",
					"default": true,
					"description": "Clear the log when executing a run"
				},
				"vscode-sonic-pi.flashBackgroundColor": {
					"type": "string",
					"default": "rgba(255,20,147,1.0)",
					"description": "Background flash color when running code"
				},
				"vscode-sonic-pi.flashTextColor": {
					"type": "string",
					"default": "rgba(255,255,255,1.0)",
					"description": "Text flash color when running code"
				},
				"vscode-sonic-pi.showPlayingLineHighlight": {
					"type": "boolean",
					"default": true,
					"description": "Highlight the line that is currently playing, like the Sonic Pi app"
				},
				"vscode-sonic-pi.autoMidiStart": {
					"type": "boolean",
					"default": true,
					"description": "Send /midi-start once per session before running code that uses midi_* functions, so MIDI is not silent"
				},
				"vscode-sonic-pi.showEditorControls": {
					"type": "boolean",
					"default": true,
					"description": "Show Run/Stop controls above the editor (CodeLens) and in the editor title bar"
				}
			}
		},
		"grammars": [
			{
				"language": "sonic-pi",
				"scopeName": "source.sonic-pi",
				"path": "./syntaxes/sonic-pi.tmLanguage.json"
			}
		],
		"viewsContainers": {
			"activitybar": [
				{
					"id": "sonic-pi",
					"title": "Sonic Pi",
					"icon": "img/sonic-pi.png"
				}
			]
		},
		"views": {
			"sonic-pi": [
				{
					"id": "sonic-pi.cues",
					"name": "Cues"
				}
			]
		}
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/node": "^22",
		"@types/utf8": "^3.0.3",
		"@types/vscode": "^1.144.0",
		"@vscode/test-cli": "^0.0.15",
		"@vscode/test-electron": "^2.5.2",
		"eslint": "^10.14.0",
		"eslint-config-prettier": "^10.1.8",
		"globals": "^6.4.1",
		"prettier": "^3.9.10",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.72.1"
	},
	"overrides": {
		"minimatch": "^11.0.4"
	},
	"dependencies": {
		"osc-js": "^2.4.1",
		"utf8": "^3.0.0",
		"uuid": "^11.1.1"
	}
}
